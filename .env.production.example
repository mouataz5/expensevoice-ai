# Production environment — copy to .env.production and fill values.
# Do NOT commit .env.production.

# Database (Postgres)
POSTGRES_USER=abes
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=abes
DATABASE_URL=postgresql://abes:CHANGE_ME_STRONG_PASSWORD@db:5432/abes

# JWT
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET

# CORS (comma-separated; must include frontend origin)
CORS_ORIGINS=https://app.abesagrotech.tn

# Redis
REDIS_URL=redis://redis:6379/0

# Celery (requis en prod si vous utilisez le service celery-worker du compose)
# Même valeur sur l’API et le worker ; défaut dans docker-compose.prod.yml : redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Storage paths are set in docker-compose (volumes mounted at /data)
# AUDIO_STORAGE_DIR=/data/audio
# INVOICE_STORAGE_DIR=/data/invoices

# Optional: LLM for extraction
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
