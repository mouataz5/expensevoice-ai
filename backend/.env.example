DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expensevoice
JWT_SECRET=super-secret-key-change-later
ACCESS_TOKEN_EXPIRE_MINUTES=60

SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_ROLE=admin

SEED_DIRECTOR_EMAIL=director@company.com
SEED_DIRECTOR_PASSWORD=Director12345!
SEED_DIRECTOR_ROLE=director

# Invoice extraction after OCR: ollama | openai | groq | mcp | fallback
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: modèle dédié achat vocal (défaut = GROQ_MODEL)
# GROQ_VOICE_MODEL=llama-3.3-70b-versatile
# Optional: max completion tokens for long OCR / many lines (default 8192)
GROQ_MAX_TOKENS=8192

MAX_PER_PURCHASE=500
DAILY_LIMIT_DEFAULT=1500
ALLOWED_CATEGORIES=vente_poulet,achat_aliment,materiel,transport,autre

# Celery (optionnel — si défini, scan facture / achat vocal passent par la file Redis)
# Ex. dev : redis://localhost:6379/0  puis : celery -A app.workers.celery_app worker -l INFO -Q invoice,voice
# CELERY_BROKER_URL=
