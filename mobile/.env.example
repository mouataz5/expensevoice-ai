# Backend API — URL sans slash final.
# Laisser vide en dev : l’app déduit l’IP du PC depuis Metro (Expo Go / téléphone sur le même Wi‑Fi).
# Forcer explicitement si besoin (remplacer par l’IPv4 de votre PC, ex. ipconfig) :
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
#
# Docker : docker compose up → API sur le port 8000 du PC.
# Comptes seed (backend/.env) : admin@company.com / Admin12345!
EXPO_PUBLIC_API_URL=
