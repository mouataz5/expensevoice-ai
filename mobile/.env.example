# ── API backend (obligatoire sur appareil réel et en production) ─────────────
# Sans cette variable, un téléphone ne peut pas joindre « localhost » (c’est le téléphone, pas votre PC).
#
# Dev (Docker sur le PC, même Wi‑Fi que le téléphone) :
#   1. Trouver l’IPv4 du PC : ipconfig (Windows) ou ifconfig / ip a
#   2. Définir :
# EXPO_PUBLIC_API_URL=http://192.168.1.XX:8000
#
# Dev avec tunnel HTTPS (ngrok, Cloudflare, etc.) :
# EXPO_PUBLIC_API_URL=https://xxxx.ngrok-free.app
#
# Laisser vide uniquement si vous utilisez le simulateur iOS / émulateur Android sur la même machine :
# l’app devine alors localhost ou 10.0.2.2 (Android emulator).
#
# Production / EAS : définir EXPO_PUBLIC_API_URL dans les secrets EAS ou eas.json → env.
# Exemple production:
# EXPO_PUBLIC_API_URL=https://api.abes-agrotech.com
# Exemple LAN dev:
EXPO_PUBLIC_API_URL=http://192.168.100.178:8000

# Optionnel : dev | prod (sinon déduit de __DEV__)
EXPO_PUBLIC_APP_ENV=dev

# Docker : docker compose up → API écoute sur le port 8000 du PC (mapper ce port dans compose).
# Comptes seed (backend/.env) : admin@company.com / Admin12345!
